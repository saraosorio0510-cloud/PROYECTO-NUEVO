    {
      "parameters": {
        "jsCode": "const req = $('Webhook - Checkin').first().json;\nconst b = (req && req.body) ? req.body : (req || {});\nconst inscripcionId = String(b.inscripcion_id ?? '').trim();\nconst eventoId = String(b.evento_id ?? '').trim();\nconst ins = $('EP06 - Leer inscripciones').all().map(x => x.json).filter(x => x && x.inscripcion_id);\nconst events = $('EP04 - Leer eventos').all().map(x => x.json).filter(x => x && x.evento_id);\nconst checkins = $('EP11 - Leer checkins').all().map(x => x.json).filter(x => x && x.inscripcion_id);\nconst now = new Date().toISOString();\nconst up = v => String(v ?? '').trim().toUpperCase();\nlet resultado = 'RECHAZADO';\nlet httpStatus = 400;\nlet detalle = '';\nconst inscripcion = inscripcionId ? ins.find(x => String(x.inscripcion_id).trim() === inscripcionId) : undefined;\nconst evento = eventoId ? events.find(x => String(x.evento_id).trim() === eventoId) : undefined;\nif (!inscripcionId || !eventoId) { httpStatus = 400; detalle = 'inscripcion_id y evento_id son obligatorios'; }\nelse if (!inscripcion) { httpStatus = 404; detalle = 'Inscripcion no encontrada'; }\nelse if (!evento) { httpStatus = 404; detalle = 'Evento no encontrado'; }\nelse if (String(inscripcion.evento_id).trim() !== eventoId) { httpStatus = 409; detalle = 'La inscripcion no corresponde al evento indicado'; }\nelse if (up(inscripcion.estado) === 'ASISTIO' || checkins.some(c => String(c.inscripcion_id).trim() === inscripcionId && up(c.resultado) === 'EXITOSO')) { resultado = 'DUPLICADO'; httpStatus = 409; detalle = 'La inscripcion ya registro check-in exitoso'; }\nelse if (up(inscripcion.estado) !== 'CONFIRMADA') { httpStatus = 409; detalle = 'La inscripcion no esta CONFIRMADA (estado ' + (inscripcion.estado || 'vacio') + ')'; }\nelse { resultado = 'EXITOSO'; httpStatus = 200; detalle = 'Check-in registrado'; }\nconst usuarioId = inscripcion ? String(inscripcion.usuario_id ?? '') : '';\nconst checkinId = 'chk-' + Date.now() + '-' + $execution.id;\nconst checkin = { checkin_id: checkinId, inscripcion_id: inscripcionId, evento_id: eventoId, usuario_id: usuarioId, fecha_checkin: now, resultado, detalle };\nconst eventoNombre = evento ? String(evento.nombre ?? eventoId) : eventoId;\nconst notify = resultado === 'EXITOSO' ? {\n  usuario_id: usuarioId,\n  tipo: 'CHECKIN_EXITOSO',\n  titulo: 'Check-in confirmado: ' + eventoNombre,\n  mensaje: 'Tu ingreso al evento ' + eventoNombre + ' fue registrado el ' + now + '. Bienvenido!',\n  evento_id: eventoId,\n  inscripcion_id: inscripcionId,\n  clave_idempotencia: 'checkin:' + inscripcionId,\n} : null;\nconst response = { ok: resultado === 'EXITOSO', resultado, mensaje: detalle, checkin_id: checkinId, inscripcion_id: inscripcionId, evento_id: eventoId, usuario_id: usuarioId, fecha_checkin: now };\nreturn [{ json: { resultado, httpStatus, checkin, fecha_actualizacion: now, notify, response } }];"
      },
